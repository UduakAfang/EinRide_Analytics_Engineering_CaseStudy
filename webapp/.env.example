# Copy to .env and fill in. .env must never be committed.
#
# Use the connection string from a Shared Access Policy on the Event Hub.
# The policy needs the Send claim to stream. Add Listen as well if you want the
# test batch's read-back step to work -- with Send only it is skipped and says so.
EVENTHUB_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy>;SharedAccessKey=<key>
EVENTHUB_NAME=telemetry
