# Copy to .env and fill in. .env must never be committed.
#
# TWO TRANSPORTS. The app picks whichever is configured, Databricks first.
#
# ---- Databricks volume (current) ----------------------------------------
# The app writes NDJSON files into a Unity Catalog volume and Auto Loader
# ingests them. Generate the token under Settings -> Developer -> Access tokens.
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal access token>
DATABRICKS_VOLUME=/Volumes/einride/bronze/landing
VOLUME_FLUSH_ROWS=500

# ---- Event Hubs (original, needs a live Azure subscription) --------------
# Left here because the code path still works. The policy needs Send to stream,
# and Listen as well if you want the test batch's read-back to work.
# EVENTHUB_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy>;SharedAccessKey=<key>
# EVENTHUB_NAME=telemetry
